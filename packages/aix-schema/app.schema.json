{
  "type": "object",
  "properties": {
    "specVersion": {
      "const": "0.1.0"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object"
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/resource"
      }
    },
    "ui": {
      "$ref": "#/$defs/ui"
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow"
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connector"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permission"
      }
    }
  },
  "required": [
    "specVersion",
    "metadata",
    "state",
    "resources",
    "ui",
    "workflows",
    "connectors",
    "permissions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aix.dev/schemas/app/0.1.0",
  "title": "AIX App Definition 0.1.0",
  "$defs": {
    "permission": {
      "type": "object",
      "properties": {
        "capability": {
          "enum": [
            "network.request",
            "file.read",
            "file.write",
            "notification.show"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "capability",
        "scopes"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "text",
            "image",
            "audio",
            "video",
            "data"
          ]
        },
        "value": {},
        "mimeType": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
        },
        "type": {
          "enum": [
            "page",
            "container",
            "text",
            "button",
            "input",
            "list",
            "table",
            "image",
            "audio",
            "video"
          ]
        },
        "props": {
          "type": "object"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ui"
          }
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
        },
        "input": {
          "type": "object"
        },
        "next": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
          }
        }
      },
      "required": [
        "id",
        "operation",
        "input"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "app.start",
            "ui.click",
            "ui.change",
            "timer"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 100
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
        },
        "on": {
          "$ref": "#/$defs/event"
        },
        "entry": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "on",
        "entry",
        "steps"
      ],
      "additionalProperties": false
    },
    "connector": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
        },
        "type": {
          "const": "http"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              }
            },
            "required": [
              "id",
              "method",
              "path"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "type",
        "baseUrl",
        "operations"
      ],
      "additionalProperties": false
    }
  }
}
