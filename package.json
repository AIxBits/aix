{
  "name": "aix",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p packages/aix-schema/tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "validate": "node packages/aix-schema/src/cli.ts",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
